# # Google Gemini API клуч (бесплатен free tier).
# # Земи го на https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-gemini-key-here

# # Еден од бесплатните модели:
# #   gemini-3.8-flash      — најдобар квалитет (препорачан)
# #   gemini-3.5-flash-lite — послаб, но повеќе барања/ден
# #   gemini-3.1-flash-lite — стабилен бесплатен
# GEMINI_MODEL=gemini-3.8-flash


# OpenAI API клуч — користи се за ЧАТ моделот и за embeddings (векторска база).
# Земи го на https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Главен чат модел (OpenAI / ChatGPT).
#   gpt-5.4-mini — брз + евтин, прифаќа temperature=0 (препорачан)
#   gpt-5-mini   — добар, но НЕ прифаќа temperature (автоматски се изостава)
#   gpt-4o-mini  — најевтин, постар модел
OPENAI_MODEL=gpt-5.4-mini

# Резервен чат модел — се користи САМО ако главниот падне (429 / 5xx / timeout).
OPENAI_FALLBACK_MODEL=gpt-4o-mini

# Gemini (бесплатен Google free tier) — РАСКОМЕНТИРАЈ за да се врати.
# Потребно е и да се раскоментира import-от во main.py и
# `langchain-google-genai` во requirements.txt.
# GEMINI_API_KEY=your-gemini-key-here
# GEMINI_MODEL=gemini-3.1-flash-lite

# Дозволени origin-и за CORS (одделени со запирка). "*" е за локален развој.
ALLOWED_ORIGINS=*

# PostgreSQL конекција до базата на производи (Neon).
# Се користи САМО за читање — чатботот не менува ништо во базата.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
